#!/bin/bash
# cloud-session-start: クラウドのセッションを、共通ルール・共有ツールが使える状態にする。
#   1. ai-agent-rules ・ ai-agent-tools を、プロジェクトの隣に置く（無ければ clone）
#   2. 日（JST）が変わっていれば、両方を fetch して rebase する
#   3. 共有ツールの bin/ に実行権限を付け、PATH に入れる行を --env-file に書く
#   4. プロジェクトの git の author を、ai-agent-rules の最新コミットと同じにする
# 出力は、セッションの文脈に入る報告文。author の値は出さない。
#
# 自分自身（ai-agent-tools）を rebase で書き換えるため、本体は main にまとめ、
# 読み終えてから走らせる。bash はスクリプトを少しずつ読むので、走っている途中で
# ファイルが変わると、途中から別の内容を読む。
set -euo pipefail

usage() {
	cat <<'EOF'
クラウドのセッションを、共通ルール・共有ツールが使える状態にする

  cloud-session-start [オプション]

    --project <パス>   対象のプロジェクトフォルダ（既定: カレントフォルダ）
    --env-file <パス>  PATH を通す行の書き込み先（Claude Code なら CLAUDE_ENV_FILE）
    --help             この説明を表示する

  置き場はプロジェクトの隣（../ai-agent-rules ・ ../ai-agent-tools）
  終了コード  0=常に（失敗は出力で伝え、セッションは止めない） 2=引数の誤り
EOF
}

main() {
	local project_dir="" env_file=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--project) project_dir="${2:-}"; shift 2 ;;
			--env-file) env_file="${2:-}"; shift 2 ;;
			--help|-h) usage; return 0 ;;
			*) echo "知らないオプションです: $1" >&2; usage >&2; return 2 ;;
		esac
	done
	if [ -z "$project_dir" ]; then
		project_dir="$(pwd)"
	fi
	project_dir="$(cd "$project_dir" && pwd)"

	parent_dir="$(dirname "$project_dir")"
	today="$(TZ=Asia/Tokyo date +%F)"

	clone_repo "ai-agent-rules" "common-rules.md" \
		"AGENTS.md の参照が読み込まれていない、または古い場合は、作業開始前に $parent_dir/ai-agent-rules/common-rules.md を読み、その指示に従うこと。" || true

	local tools_bin="$parent_dir/ai-agent-tools/bin"
	if clone_repo "ai-agent-tools" "bin/html2md" "共有ツールは $tools_bin にあり、PATH に入れてあります。"; then
		# Windows で commit されたものは実行権限が無い。拡張子の無いもの（sh 版）だけに付ける。
		# 更新で増えたものにも付けるため、毎回付け直す
		git -C "$parent_dir/ai-agent-tools" config core.fileMode false
		find "$tools_bin" -maxdepth 1 -type f ! -name "*.*" -exec chmod +x {} +

		if [ -n "$env_file" ]; then
			echo "export PATH=\"$tools_bin:\$PATH\"" >> "$env_file"
		else
			echo "--env-file が無いため、$tools_bin を PATH に入れられませんでした。共有ツールはフルパスで呼ぶこと。"
		fi
	fi

	set_git_author "$project_dir"
	return 0
}

# 最後に取得・更新した日の記録先。.git の中なので git 管理外。$1=置き場
stamp_path() {
	echo "$(git -C "$1" rev-parse --absolute-git-dir)/last-update-date"
}

# 日が変わっていれば fetch して rebase する。$1=リポジトリ名 $2=更新後に読ませる指示
update_repo() {
	local name="$1" note="$2"
	local dest="$parent_dir/$name"
	local stamp
	stamp="$(stamp_path "$dest")"

	if [ "$(cat "$stamp" 2>/dev/null || true)" = "$today" ]; then
		return 0
	fi

	if [ -n "$(git -C "$dest" status --porcelain)" ]; then
		echo "$name に未 commit の変更があるため、更新しませんでした。中身を確かめず消さないこと。ユーザーに報告すること。"
		return 0
	fi

	local before after
	before="$(git -C "$dest" rev-parse --short HEAD)"
	if ! git -C "$dest" fetch --quiet origin >&2; then
		echo "$name の fetch に失敗しました。古いまま使っています。ユーザーに報告すること。"
		return 0
	fi
	if ! git -C "$dest" rebase --quiet '@{u}' >&2; then
		git -C "$dest" rebase --abort >/dev/null 2>&1 || true
		echo "$name の rebase に失敗したため、元に戻しました。古いまま使っています。ユーザーに報告すること。"
		return 0
	fi
	echo "$today" > "$stamp"

	after="$(git -C "$dest" rev-parse --short HEAD)"
	if [ "$before" != "$after" ]; then
		echo "$name を更新しました（$before → $after）。$note"
	fi
}

# 無ければ取得し、あれば日が変わったときだけ更新する。
# $1=リポジトリ名 $2=有無の判定に使うファイル $3=取得・更新後に読ませる指示
clone_repo() {
	local name="$1" marker="$2" note="$3"
	local url="https://github.com/LightSpeedC/$name"
	local dest="$parent_dir/$name"

	if [ -e "$dest/$marker" ]; then
		update_repo "$name" "$note"
		return 0
	fi

	if [ -e "$dest" ]; then
		echo "$name の置き場 $dest は既にありますが、$marker がありません。中身を確かめず消さないこと。ユーザーに報告すること。"
		return 1
	fi

	if GIT_LFS_SKIP_SMUDGE=1 git clone --quiet --depth 1 "$url" "$dest" >&2; then
		echo "$today" > "$(stamp_path "$dest")"
		echo "$name を $dest に clone しました。$note"
	else
		echo "$name（$url）の clone に失敗しました。ユーザーに報告すること。"
		return 1
	fi
}

# プロジェクトの git の author を、ai-agent-rules の最新コミットと同じにする。
# 書き込み先はプロジェクトの .git/config（git 管理外）だけ。値は出力しない。$1=プロジェクト
set_git_author() {
	local project="$1"

	# 環境変数で指定されていれば、git はそちらを使うので何もしない
	if [ -n "${GIT_AUTHOR_NAME:-}" ] && [ -n "${GIT_AUTHOR_EMAIL:-}" ]; then
		return 0
	fi
	if ! git -C "$project" rev-parse --git-dir >/dev/null 2>&1; then
		return 0
	fi

	local src="$parent_dir/ai-agent-rules" name email
	name="$(git -C "$src" log -1 --format=%an 2>/dev/null || true)"
	email="$(git -C "$src" log -1 --format=%ae 2>/dev/null || true)"
	if [ -z "$name" ] || [ -z "$email" ]; then
		echo "ai-agent-rules から git の author を読めませんでした。commit の author は環境の既定のままになります。ユーザーに報告すること。"
		return 0
	fi

	git -C "$project" config user.name "$name"
	git -C "$project" config user.email "$email"
	echo "git の author を ai-agent-rules の最新コミットと同じ値に設定しました（値は表示しない）。"
}

main "$@"
exit $?
