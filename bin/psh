#!/bin/sh
# PowerShell を呼んで、出力を UTF-8 に直して流す。
# 中身は src/psh/main.ts。bun を優先し、無ければ node で走らせる。
#
# 呼ぶのは powershell（Windows PowerShell 5.1）。pwsh（7）ではない。
#
# exec の次の行には来ない。exec はプロセスを置き換えるためで、
# exec 自体が失敗したときもシェルごと終わる。
# それでも exit を書くのは、分岐がここで終わることを目で追えるようにするため。
dir=$(dirname "$0")

if command -v bun >/dev/null 2>&1; then
	exec bun "$dir/../src/psh/main.ts" "$@"
	exit $?
fi

if command -v node >/dev/null 2>&1; then
	exec node "$dir/../src/psh/main.ts" "$@"
	exit $?
fi

echo "[NG] bun か node が必要です" >&2
exit 2
