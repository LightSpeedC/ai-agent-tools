#!/bin/sh
# safe-push: 複数の場所から書き換えられるリポジトリを、commit → pull --rebase → push の一続きで、壊さずに同期する。
# 中身は src/safe-push/main.ts。bun を優先し、無ければ node で走らせる。
#
# exec の次の行には来ない。exec はプロセスを置き換えるためで、
# exec 自体が失敗したときもシェルごと終わる。
# それでも exit を書くのは、分岐がここで終わることを目で追えるようにするため。
#
# 終了コードに 2 を使わない。Stop フックが 2 を「続ける」と読むため。
dir=$(dirname "$0")

if command -v bun >/dev/null 2>&1; then
	exec bun "$dir/../src/safe-push/main.ts" "$@"
	exit $?
fi

if command -v node >/dev/null 2>&1; then
	exec node "$dir/../src/safe-push/main.ts" "$@"
	exit $?
fi

echo "[NG] bun か node が必要です" >&2
exit 1
